#!/usr/bin/env python3
"""One-time Google authorization for the leonavas.calendar bar plugin.

Runs the OAuth loopback flow for an "installed app": it starts a throwaway
HTTP server on 127.0.0.1, sends you to Google's consent screen, catches the
redirect, and trades the code for a refresh token that lives in
~/.local/state/omarchy/calendar/credentials.json (0600).

The loopback flow is used rather than the retired out-of-band one because
Google turned OOB off in 2022; a Desktop-type client may redirect to any
127.0.0.1 port, so nothing has to be registered beyond the client itself.

Usage:
  gcal-auth                                  # prompts for client id/secret
  gcal-auth --client-secret-file <path.json> # reads the console download
  gcal-auth --status                         # who is authorized, if anyone
  gcal-auth --reset                          # forget the stored token
"""

import argparse
import base64
import hashlib
import http.server
import json
import os
import secrets
import socket
import sys
import threading
import urllib.parse
import webbrowser

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from gcalcommon import (  # noqa: E402
    AUTH_ENDPOINT, CREDENTIALS_FILE, SCOPE, TOKEN_ENDPOINT, TOKEN_FILE,
    AuthError, api_get, eprint, http_json, read_json, write_json_private)

SETUP_HELP = """
No OAuth client stored yet. Create one once — it takes about five minutes.

Google renamed these screens in 2025: what the older guides call the "OAuth
consent screen" is now "Google Auth Platform", and its settings were split
across Audience / Data Access / Clients.

  1. https://console.cloud.google.com/  ->  create (or pick) a project
  2. Enable the API:
       https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
  3. APIs & Services -> OAuth consent screen (a.k.a. Google Auth Platform)
       • Audience     -> User type "Internal" if your Google Workspace allows
                         it (no review needed). Otherwise "External", and add
                         your own address under "Test users".
       • Data Access  -> Add or remove scopes -> tick
                         .../auth/calendar.readonly -> Update -> Save
  4. Clients -> "+ Create client"
       • Application type: "Desktop app"
       • Create, then download its JSON
  5. Run:
       gcal-auth --client-secret-file ~/Downloads/client_secret_*.json
     or paste the client ID and secret when prompted below.
""".strip()

# Google's redirect lands in a real browser tab, so it gets a real page.
DONE_PAGE = """<!doctype html><meta charset="utf-8">
<title>Calendar connected</title>
<style>
 body{background:#101315;color:#cacccc;font:16px/1.6 system-ui,sans-serif;
      display:grid;place-items:center;height:100vh;margin:0}
 div{text-align:center} h1{font-weight:600;font-size:20px;margin:0 0 8px}
 p{margin:0;opacity:.65;font-size:14px}
</style>
<div><h1>%s</h1><p>%s</p></div>
"""


def pkce_pair():
    """A verifier and its S256 challenge.

    PKCE is not strictly required for a confidential-ish desktop client, but
    the "secret" in an installed app ships on disk and is therefore public;
    the verifier is what actually binds this code to this process.
    """
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(64)).rstrip(b"=")
    digest = hashlib.sha256(verifier).digest()
    challenge = base64.urlsafe_b64encode(digest).rstrip(b"=")
    return verifier.decode(), challenge.decode()


class CallbackHandler(http.server.BaseHTTPRequestHandler):
    """Catches Google's one redirect and hands the query back to the main thread."""

    result = None
    expected_state = None

    def do_GET(self):  # noqa: N802 - name fixed by BaseHTTPRequestHandler
        query = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        state = (query.get("state") or [""])[0]
        code = (query.get("code") or [""])[0]
        error = (query.get("error") or [""])[0]

        if state != CallbackHandler.expected_state:
            # A stray request on the loopback port, not our redirect.
            self.send_response(400)
            self.end_headers()
            return

        if error:
            CallbackHandler.result = {"error": error}
            title, detail = "Authorization declined", error
        else:
            CallbackHandler.result = {"code": code}
            title, detail = ("Calendar connected",
                             "You can close this tab and go back to the bar.")

        body = (DONE_PAGE % (title, detail)).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass  # the server is an implementation detail; keep the console clean


def client_from_file(path):
    raw = read_json(os.path.expanduser(path))
    if not raw:
        raise SystemExit("could not read %s as JSON" % path)
    # The console hands out {"installed": {...}} for desktop clients and
    # {"web": {...}} for the other kind; accept either shape.
    block = raw.get("installed") or raw.get("web") or raw
    client_id = block.get("client_id", "")
    client_secret = block.get("client_secret", "")
    if not client_id:
        raise SystemExit("%s has no client_id — is it an OAuth client download?"
                         % path)
    return client_id, client_secret


def prompt_for_client():
    if not sys.stdin.isatty():
        raise SystemExit(SETUP_HELP)
    print(SETUP_HELP)
    print()
    client_id = input("Client ID: ").strip()
    client_secret = input("Client secret: ").strip()
    if not client_id:
        raise SystemExit("no client ID given")
    return client_id, client_secret


def authorize(client_id, client_secret, open_browser=True):
    verifier, challenge = pkce_pair()
    state = secrets.token_urlsafe(24)
    CallbackHandler.expected_state = state
    CallbackHandler.result = None

    # Port 0 lets the kernel pick a free one; a Desktop client accepts any
    # loopback port, so there is nothing to keep in sync with the console.
    server = http.server.HTTPServer(("127.0.0.1", 0), CallbackHandler)
    server.socket.settimeout(1)
    port = server.server_address[1]
    redirect_uri = "http://127.0.0.1:%d/" % port

    params = {
        "client_id": client_id,
        "redirect_uri": redirect_uri,
        "response_type": "code",
        "scope": SCOPE,
        "state": state,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
        # Offline + a forced consent screen is what makes Google attach a
        # refresh token; re-authorizing an already-approved client silently
        # returns an access token only, and the widget would stop syncing an
        # hour later.
        "access_type": "offline",
        "prompt": "consent",
    }
    url = AUTH_ENDPOINT + "?" + urllib.parse.urlencode(params)

    thread = threading.Thread(target=_serve_until_answered, args=(server,),
                              daemon=True)
    thread.start()

    print("\nOpening Google's consent screen…")
    print("If nothing opens, paste this into a browser:\n\n  %s\n" % url)
    if open_browser:
        try:
            webbrowser.open(url)
        except Exception:
            pass

    thread.join(timeout=300)
    server.server_close()

    result = CallbackHandler.result
    if not result:
        raise SystemExit("timed out waiting for the browser redirect")
    if result.get("error"):
        raise SystemExit("Google returned: %s" % result["error"])

    tokens = http_json(TOKEN_ENDPOINT, data={
        "client_id": client_id,
        "client_secret": client_secret,
        "code": result["code"],
        "code_verifier": verifier,
        "grant_type": "authorization_code",
        "redirect_uri": redirect_uri,
    })
    refresh_token = tokens.get("refresh_token")
    if not refresh_token:
        raise SystemExit(
            "Google issued no refresh token. Revoke the app at "
            "https://myaccount.google.com/permissions and run this again.")

    write_json_private(CREDENTIALS_FILE, {
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": refresh_token,
        "scope": SCOPE,
    })
    # Any token cached against the previous grant is meaningless now.
    if os.path.exists(TOKEN_FILE):
        os.unlink(TOKEN_FILE)
    return tokens


def _serve_until_answered(server):
    while CallbackHandler.result is None:
        try:
            server.handle_request()
        except (socket.timeout, OSError):
            continue


def show_status():
    credentials = read_json(CREDENTIALS_FILE)
    if not credentials or not credentials.get("refresh_token"):
        print("not authorized — run gcal-auth")
        return 1
    print("client id : %s" % credentials.get("client_id", "?"))
    print("token file: %s" % CREDENTIALS_FILE)
    try:
        profile = api_get("/users/me/calendarList", {"maxResults": 250})
    except AuthError as error:
        print("authorization rejected: %s" % error)
        print("run gcal-auth again to reconnect")
        return 1
    except Exception as error:  # network, API disabled, etc.
        print("could not reach Google: %s" % error)
        return 1
    items = profile.get("items", [])
    primary = next((c for c in items if c.get("primary")), None)
    print("account   : %s" % (primary.get("id") if primary else "unknown"))
    print("calendars : %d (%d shown in Google Calendar)"
          % (len(items), sum(1 for c in items if c.get("selected"))))
    for calendar in items:
        if not calendar.get("selected"):
            continue
        print("  • %s" % calendar.get("summary", calendar.get("id")))
    return 0


def main():
    parser = argparse.ArgumentParser(
        description="Authorize the Omarchy calendar widget with Google.")
    parser.add_argument("--client-secret-file",
                        help="OAuth client JSON downloaded from Google Cloud")
    parser.add_argument("--client-id", help="OAuth client ID")
    parser.add_argument("--client-secret", help="OAuth client secret")
    parser.add_argument("--status", action="store_true",
                        help="show which account is connected")
    parser.add_argument("--reset", action="store_true",
                        help="delete the stored credentials")
    parser.add_argument("--no-browser", action="store_true",
                        help="print the URL instead of opening a browser")
    args = parser.parse_args()

    if args.reset:
        for path in (CREDENTIALS_FILE, TOKEN_FILE):
            if os.path.exists(path):
                os.unlink(path)
        print("stored credentials removed")
        return 0

    if args.status:
        return show_status()

    if args.client_secret_file:
        client_id, client_secret = client_from_file(args.client_secret_file)
    elif args.client_id:
        client_id, client_secret = args.client_id, (args.client_secret or "")
    else:
        stored = read_json(CREDENTIALS_FILE) or {}
        if stored.get("client_id"):
            # Re-authorizing an account: the client is already known, only the
            # grant needs replacing.
            client_id = stored["client_id"]
            client_secret = stored.get("client_secret", "")
            print("Reusing the stored OAuth client (%s)." % client_id)
        else:
            client_id, client_secret = prompt_for_client()

    authorize(client_id, client_secret, open_browser=not args.no_browser)
    print("\nAuthorized. Fetching your calendars…\n")
    return show_status()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        eprint("\ncancelled")
        sys.exit(130)
